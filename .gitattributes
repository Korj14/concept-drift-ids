# Reconstruct frozen evidence with the line endings used at generation time.
# System-A v1 CSVs were generated by csv.DictWriter on Windows (CRLF).
results/frozen/system_a_v1/*.csv text eol=crlf
results/frozen/system_a_v1/*.json text eol=lf

# The post-freeze count supplement is repository-canonical LF.
results/frozen/system_a_v1_supplement_v1/*.csv text eol=lf
results/frozen/system_a_v1_supplement_v1/*.json text eol=lf

# R0.v2 rule JSONs are frozen as repository-canonical LF text.
# Runtime verification is also EOL-normalized so historical Windows
# autocrlf checkouts remain portable without changing the frozen artifact.
data/rules/system_b_r0_v2/*.json text eol=lf
data/manifests/system_b_v2.json text eol=lf

# Primary C/D configuration and compact evidence use repository-canonical LF.
data/manifests/cd_primary_run_config_v1.json text eol=lf
results/frozen/cd_primary_v1/** text eol=lf

# Frozen dependency lock is canonical UTF-8/LF text.
requirements-lock.txt text eol=lf
data/manifests/cd_primary_run_config_v1_1.json text eol=lf
data/manifests/cd_primary_mechanism_audit_v1.json text eol=lf
data/manifests/cd_primary_mechanism_audit_v1_1.json text eol=lf
data/manifests/cd_primary_mechanism_audit_v1_2.json text eol=lf
results/frozen/cd_primary_mechanism_v1_2/** text eol=lf
